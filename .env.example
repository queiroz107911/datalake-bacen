# Exemplo de variáveis de ambiente para execução LOCAL.
# Copie para `.env` e ajuste. NUNCA versione o `.env` real (está no .gitignore).
#
# Em produção, estas variáveis são definidas pelo Terraform na configuração da
# Lambda — não por arquivo .env.

# Bucket S3 da camada Bronze onde os JSONs crus são gravados.
BRONZE_BUCKET=datalake-bacen-dev-bronze-000000000000

# Séries do SGS/BACEN a ingerir, separadas por vírgula (12=SELIC, 433=IPCA).
SGS_SERIES=12,433

# (Opcional) Nome do Glue Job a disparar após a ingestão.
# Deixe em branco/ausente para NÃO disparar o job (útil em testes locais).
# GLUE_JOB_NAME=datalake-bacen-dev-transform

# Região AWS (usada pelo boto3 ao rodar localmente).
AWS_DEFAULT_REGION=us-east-1
